# =====================================================================
# Sahayak AI: Environment Variables & Database Configuration
# =====================================================================
# Instructions:
# 1. Copy this file to '.env.local' (cp .env.example .env.local).
# 2. Fill in your Supabase project credentials from Project Settings > API.
# 3. If left blank, Sahayak AI will automatically use its internal
#    atomic JSON data store (ideal for offline college viva demonstrations).
# =====================================================================

# 1. Public Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Supabase Anonymous Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Secret Supabase Service Role Key (RESTRICTED: Never expose to frontend!)
# Used by Next.js server-side route handlers to bypass RLS for administrative operations.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. JWT & Session Security Secret (optional custom salt)
JWT_SECRET=faqpilot_ai_secure_production_secret_key_2026

# 5. Administrator Account Credentials (Server-side Only)
# Configure the admin password securely via this environment variable.
# Never expose this variable to client-side frontend code.
ADMIN_EMAIL=rupam@gmail.com
ADMIN_PASSWORD=Admin@1234
